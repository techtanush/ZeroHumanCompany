# ZEROTH — environment
# cp .env.example .env    Never commit .env.
#
# NOTHING here is required to run the backend today. With zero keys set, every
# vendor driver falls back to a deterministic mock and the model falls back to
# MockLlmClient. Paste keys in as they arrive; no code changes needed.

# ── Core ────────────────────────────────────────────────────────────────────
ZEROTH_ENV=local                    # local | demo | prod
ZEROTH_TOOLS=mock                   # mock | real   ← the one-line flip
ZEROTH_LLM=mock                     # mock | real   (real requires ANTHROPIC_API_KEY)
ZEROTH_TIME_SCALE=1.0               # 0.001 on stage: "daily" cron fires every ~90s
ZEROTH_KILL_SWITCH=off
PORT=4000
KERNEL_URL=http://localhost:4000
KERNEL_SHARED_TOKEN=dev-only-token  # bearer token for every /v1 route
KERNEL_SIGNING_KEY=dev-signing-key  # HMAC key artifacts are signed with
KERNEL_VAULT_KEY=dev-only-vault-key # master key for the credential vault

# ── Data ────────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use embedded PGlite (no docker needed).
DATABASE_URL=
PGLITE_DIR=.pgdata                  # or `memory` for an ephemeral database
REDIS_URL=

# ── Models ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # console.anthropic.com. Until set, MockLlmClient runs.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_OPUS=claude-opus-4-20250514
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
ANTHROPIC_MODEL_HAIKU=claude-3-5-haiku-20241022

# ── Sponsors: Tier 1 (load-bearing) ─────────────────────────────────────────
TERAC_API_KEY=
TERAC_BASE_URL=
BAND_API_KEY=
BAND_BASE_URL=
BAND_WORKSPACE_ID=
STRIPE_SECRET_KEY=                  # USE TEST KEYS (sk_test_...). Say so on stage.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SOLARI_API_KEY=
SOLARI_BASE_URL=
SUPERSERVE_API_KEY=                 # absent ⇒ local docker/child_process sandbox driver
SUPERSERVE_POOL_SIZE=4
LINQ_API_KEY=
LINQ_BASE_URL=
LINQ_WEBHOOK_SECRET=
FOUNDER_PHONE=                      # +1... the number Linq approval cards go to
REPLAY_API_KEY=
RENDER_API_KEY=
RENDER_OWNER_ID=

# ── Sponsors: Tier 2 (optional, mocked by default) ──────────────────────────
LOVABLE_API_KEY=
WHOP_API_KEY=
WHOP_COMPANY_ID=
DODO_API_KEY=
PIONEER_API_KEY=
PIONEER_MODEL_LEAD_SCORE=

# ── Tool plane ──────────────────────────────────────────────────────────────
BUSINESS_TOOLS_URL=                 # optional internal gateway for leadgen/crm/support/metrics tools
BUSINESS_TOOLS_API_KEY=
COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
APIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── The company's own accounts ──────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_ORG=
COMPANY_EMAIL=

# ── simpop ──────────────────────────────────────────────────────────────────
SIMPOP_URL=http://localhost:8080
SIMPOP_SEED=42
SIMPOP_ARCHETYPES=12

# ── Demo ────────────────────────────────────────────────────────────────────
DEMO_VENTURE_ID=demo-1
DEMO_REPLAY_SPEED=8
DEMO_OFFLINE=false
